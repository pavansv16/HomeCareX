# HomeCareX — Docker env template
# Copy to `.env` at the REPO ROOT and fill in YOUR OWN values:
#   cp .env.docker.example .env
#
# WARNING: do NOT copy values from backend/.env.example — that committed
# file contains real-looking credentials. Rotate them and use fresh ones.
#
# Required
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=mongodb://mongo:27017/homecarex
REDIS_URL=redis://redis:6379

# Optional (leave blank if unused)
NODE_ENV=production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RECAPTCHA_SECRET_KEY=
BOOKING_REQUIRE_PAYMENT=true
PAYOUTS_DEMO_MODE=true

# Frontend build args (defaults are fine for local Docker use)
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=
